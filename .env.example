SUPABASE_URL="https://zvxqvelosmswdwntnpbe.supabase.co"

# Supabase Service Role Key (secret): Required for backend administrative access & RLS bypass
SUPABASE_SERVICE_ROLE_KEY=""

# PostgreSQL Direct/Pooler Connection String (e.g., postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres)
